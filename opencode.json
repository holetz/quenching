{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "quenching": {
      "type": "local",
      "command": [
        "python3",
        ".agents/quenching/assets/bin/cq",
        "mcp",
        "--only",
        "specs,git,components"
      ],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "~/Projetos/quenching-slot-*": "allow",
      "~/Projetos/quenching.*": "allow"
    },
    "bash": {
      ".agents/quenching/bin/cq": "allow",
      ".agents/quenching/bin/cq *": "allow",
      "./.agents/quenching/bin/cq *": "allow",
      "python3 .agents/quenching/bin/cq *": "allow",
      "python .agents/quenching/bin/cq *": "allow"
    }
  },
  "experimental": {
    "subagent_depth": 4
  }
}
