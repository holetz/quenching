# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Python (the validation hook is Python; no build, but ignore caches)
__pycache__/
*.py[cod]
.venv/
venv/

# Per-developer hook overrides installed into a target repo (never committed there,
# and never here either): the plugin ships only the shared hooks-config.json
hooks-config.local.json
settings.local.json

# Documentation pipeline plan-of-record (target-repo scratch, outside docs_dir)
.quenching/

# Local Zensical output and cache; the source is staged from docs/.
site/
.cache/
# Generated, bounded Zensical input; the complete OKF bundle remains under docs/.
site-source/

# The documentation-site checker keeps a committed static fixture named `site/`.
!plugins/quenching/assets/checks/fixtures/documentation-site-check/glossary/site/
!plugins/quenching/assets/checks/fixtures/documentation-site-check/glossary/site/**
!plugins/quenching-codex/checks/fixtures/documentation-site-check/glossary/site/
!plugins/quenching-codex/checks/fixtures/documentation-site-check/glossary/site/**
