# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Python (the validation hook is Python; no build, but ignore caches)
__pycache__/
*.py[cod]
.venv/
venv/

# Per-developer hook overrides installed into a target repo (never committed there,
# and never here either): the plugin ships only the shared hooks-config.json
hooks-config.local.json
settings.local.json

# Worktrees — including the persistent one the `files` spec backend creates on demand for
# the dedicated specs branch. It MUST be ignored: an untracked worktree is untracked
# content in the working tree, which breaks the clean-tree gate /specs:execute requires
# before its first task. The backend would sabotage the command that drives it.
.claude/worktrees/
