{
  "backend": "github",
  "shared": {
    "hooks": {
      "after_specs_execute_task": [
        {"command": "/security-review", "optional": true, "condition": "Run only when the task touches sensitive surface: workflows, release, approval stamps, hooks or scripts."}
      ]
    }
  },
  "proof": {
    "proofRoot": "plugins/quenching/tests",
    "layers": {},
    "measuredRoots": ["plugins/quenching/assets/bin/quenching"],
    "proofExclusions": ["scripts"],
    "ratchetPath": ".coverage-floor.json"
  },
  "delivery": {
    "provider": "github"
  }
}
