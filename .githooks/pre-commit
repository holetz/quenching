#!/bin/sh
# pre-commit — stamp the plugin's dev version file with the current commit ref.
#
# The version the `quenching-management` skill announces lives in a file that is
# PACKAGED WITH THE PLUGIN:
#     plugins/claude-quenching/VERSION
# so it travels wherever the plugin is installed (there is no git there to ask).
# While in development the version IS the short commit hash; at release it
# becomes a real semver and this hook can be retired.
#
# A commit cannot contain its own hash, so we stamp the tip that becomes this
# commit's PARENT — the latest already-built revision. The file is staged here
# so the value ships inside the commit and the working tree stays clean.

set -eu

repo_root=$(git rev-parse --show-toplevel)
version_file="$repo_root/plugins/claude-quenching/VERSION"

if git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
  ref=$(git rev-parse --short HEAD)
else
  ref="0000000"   # first commit — no HEAD yet
fi

# Rewrite + re-stage only when the value actually changes, so a commit that
# doesn't advance the ref stays minimal.
current=$(cat "$version_file" 2>/dev/null || printf '')
if [ "$current" != "$ref" ]; then
  printf '%s\n' "$ref" > "$version_file"
  git add "$version_file"
fi
