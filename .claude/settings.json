{
  "enabledPlugins": {
    "context7@context7-marketplace": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|bash|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'.agents/quenching/assets/hooks/dispatch.py');os.path.isfile(p) or (print('{}'),sys.exit(0));runpy.run_path(p,run_name='__main__')\" deny-claude-coauthor warn-git-add-all",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
