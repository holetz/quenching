{
  "enabledPlugins": {
    "context7@context7-marketplace": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|bash|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'.agents/quenching/assets/hooks/dispatch.py');os.path.isfile(p) or (print('{}'),sys.exit(0));runpy.run_path(p,run_name='__main__')\" deny-claude-coauthor warn-git-add-all",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'.agents/quenching/assets/hooks/dispatch.py');os.path.isfile(p) or (print('{}'),sys.exit(0));runpy.run_path(p,run_name='__main__')\" adopt-worktree",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "quenching"
  ],
  "permissions": {
    "allow": [
      "Bash(.agents/quenching/bin/cq:*)",
      "Bash(./.agents/quenching/bin/cq:*)",
      "Bash(python3 .agents/quenching/bin/cq:*)",
      "Bash(python .agents/quenching/bin/cq:*)",
      "Read(~/Projetos/quenching-slot-*/**)",
      "Edit(~/Projetos/quenching-slot-*/**)",
      "Write(~/Projetos/quenching-slot-*/**)",
      "Read(~/Projetos/quenching.*/**)",
      "Edit(~/Projetos/quenching.*/**)",
      "Write(~/Projetos/quenching.*/**)",
      "Read(~/Projects/quenching-slot-*/**)",
      "Edit(~/Projects/quenching-slot-*/**)",
      "Write(~/Projects/quenching-slot-*/**)",
      "Read(~/Projects/quenching.*/**)",
      "Edit(~/Projects/quenching.*/**)",
      "Write(~/Projects/quenching.*/**)"
    ]
  }
}
