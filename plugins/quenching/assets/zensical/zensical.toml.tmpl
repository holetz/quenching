# zensical.toml — Zensical config for the OKF `documentation/` home.
# `/quenching:knowledge:align` stamps this at the repo ROOT (outside /.knowledge/), and
# `/quenching:knowledge:documentation:build` owns it from there. Fill the <placeholders>.
[project]
  site_name        = "<YOUR PROJECT> — Documentation"
  site_description = "<one-line description of the product docs>"
  # site_url       = "https://<org>.github.io/<repo>/"   # canonical/social links; required by navigation.instant

  docs_dir = ".knowledge/documentation"
  site_dir = "site"

  # Zensical runs no MkDocs plugin, so the order and the titles live here rather
  # than in `.pages` files. A NEW PAGE IS A NEW LINE in this list; a page missing
  # from it is still built, but it is absent from the sidebar.
  nav = [
    "index.md",
    { "Getting started" = [ "tutorials/index.md" ] },
    { "How-to guides"   = [ "how-to/index.md" ] },
    { "Reference"       = [ "reference/index.md" ] },
    { "Concepts"        = [ "explanation/index.md" ] },
  ]

  extra_css = [ "assets/stylesheets/quenching.css" ]

[project.theme]
  # language = "pt-BR"   # the theme is localized; the search UI is English-only for now
  features = [
    "navigation.indexes",
    "navigation.sections",
    "navigation.footer",
    "navigation.tracking",
    "navigation.top",
    "toc.follow",
    "content.code.copy",
    "content.code.annotate",
    "content.tabs.link",
    "search.highlight",
  ]

[[project.theme.palette]]
  media       = "(prefers-color-scheme: light)"
  scheme      = "default"
  toggle.icon = "material/weather-night"
  toggle.name = "Switch to dark mode"

[[project.theme.palette]]
  media       = "(prefers-color-scheme: dark)"
  scheme      = "slate"
  toggle.icon = "material/weather-sunny"
  toggle.name = "Switch to light mode"

# Zensical uses the same Python-Markdown as MkDocs, so the extensions carry over;
# in TOML the `!!python/name:` values are plain strings.
[project.markdown_extensions]
  admonition                         = {}
  attr_list                          = {}
  md_in_html                         = {}
  tables                             = {}
  toc.permalink                      = true
  pymdownx.details                   = {}
  pymdownx.highlight                 = {}
  pymdownx.inlinehilite              = {}
  pymdownx.tabbed.alternate_style    = true
  pymdownx.emoji.emoji_index         = "zensical.extensions.emoji.twemoji"
  pymdownx.emoji.emoji_generator     = "zensical.extensions.emoji.to_svg"
  pymdownx.superfences.custom_fences = [
    { name = "mermaid", class = "mermaid", format = "pymdownx.superfences.fence_code_format" },
  ]
