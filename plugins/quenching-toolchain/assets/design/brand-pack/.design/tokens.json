{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "org.quenching": {
      "name": "Project Design System",
      "description": "A restrained, accessible system whose exact values have one source.",
      "generatedAt": "__GENERATED_AT__",
      "productSchema": 1,
      "designMd": {
        "version": "alpha",
        "spec": "https://github.com/google-labs-code/design.md/blob/main/docs/spec.md",
        "components": {
          "button-primary": {
            "backgroundColor": "{colors.primary}",
            "textColor": "{colors.on-primary}",
            "typography": "{typography.label}",
            "rounded": "{rounded.sm}",
            "padding": "{spacing.sm} {spacing.lg}",
            "height": "{spacing.xl}"
          },
          "input": {
            "backgroundColor": "{colors.surface}",
            "textColor": "{colors.on-surface}",
            "typography": "{typography.body}",
            "rounded": "{rounded.sm}",
            "padding": "{spacing.sm} {spacing.md}",
            "height": "{spacing.xl}"
          },
          "card": {
            "backgroundColor": "{colors.surface}",
            "textColor": "{colors.on-surface}",
            "rounded": "{rounded.md}",
            "padding": "{spacing.lg}"
          },
          "chip": {
            "backgroundColor": "{colors.secondary}",
            "textColor": "{colors.on-secondary}",
            "typography": "{typography.label}",
            "rounded": "{rounded.full}",
            "padding": "{spacing.xs} {spacing.sm}"
          },
          "navigation": {
            "backgroundColor": "{colors.surface}",
            "textColor": "{colors.on-surface}",
            "typography": "{typography.label}",
            "padding": "{spacing.md} {spacing.lg}"
          }
        }
      }
    }
  },
  "colors": {
    "$type": "color",
    "primary": {
      "$description": "The single accent for primary action and emphasis.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.058824, 0.462745, 0.431373],
        "hex": "#0F766E"
      },
      "$extensions": {
        "org.quenching": {
          "impeccable": {
            "role": "primary",
            "displayName": "Deep teal",
            "canonical": "oklch(49% 0.09 185)",
            "tonalRamp": ["#042F2E", "#134E4A", "#115E59", "#0F766E", "#0D9488", "#14B8A6", "#5EEAD4", "#CCFBF1"]
          }
        }
      }
    },
    "on-primary": {
      "$description": "Foreground on the primary accent.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#FFFFFF"
      }
    },
    "secondary": {
      "$description": "A quiet support surface for tags and secondary emphasis.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8, 0.980392, 0.945098],
        "hex": "#CCFBEF"
      }
    },
    "on-secondary": {
      "$description": "Foreground on secondary surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.015686, 0.184314, 0.180392],
        "hex": "#042F2E"
      }
    },
    "surface": {
      "$description": "The primary page and component surface.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.980392, 0.980392, 0.976471],
        "hex": "#FAFAF9"
      }
    },
    "on-surface": {
      "$description": "The primary readable ink.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.109804, 0.098039, 0.090196],
        "hex": "#1C1917"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$description": "Editorial display voice for high-salience titles.",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {"value": 48, "unit": "px"},
        "fontWeight": 700,
        "letterSpacing": {"value": -1, "unit": "px"},
        "lineHeight": 1.1
      },
      "$extensions": {
        "org.quenching": {
          "impeccable": {"displayName": "Display", "purpose": "High-salience titles only."}
        }
      }
    },
    "body": {
      "$description": "Readable body copy across media.",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {"value": 16, "unit": "px"},
        "fontWeight": 400,
        "letterSpacing": {"value": 0, "unit": "px"},
        "lineHeight": 1.6
      }
    },
    "label": {
      "$description": "Compact labels, buttons, and navigation.",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {"value": 12, "unit": "px"},
        "fontWeight": 600,
        "letterSpacing": {"value": 1, "unit": "px"},
        "lineHeight": 1.2
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {"$description": "Controls and compact surfaces.", "$value": {"value": 4, "unit": "px"}},
    "md": {"$description": "Cards and larger surfaces.", "$value": {"value": 8, "unit": "px"}},
    "full": {"$description": "Pills and circular affordances.", "$value": {"value": 999, "unit": "px"}}
  },
  "spacing": {
    "$type": "dimension",
    "xs": {"$value": {"value": 4, "unit": "px"}},
    "sm": {"$value": {"value": 8, "unit": "px"}},
    "md": {"$value": {"value": 16, "unit": "px"}},
    "lg": {"$value": {"value": 24, "unit": "px"}},
    "xl": {"$value": {"value": 48, "unit": "px"}}
  },
  "layout": {
    "$type": "dimension",
    "reading": {"$description": "Readable measure for long-form text.", "$value": {"value": 45, "unit": "rem"}},
    "content-wide": {"$description": "Wide frame for evidence and comparisons.", "$value": {"value": 72, "unit": "rem"}}
  },
  "strokes": {
    "$type": "dimension",
    "control": {"$description": "Default control border.", "$value": {"value": 1, "unit": "px"}},
    "rule": {"$description": "Editorial accent rule.", "$value": {"value": 2, "unit": "px"}}
  },
  "shadows": {
    "$type": "shadow",
    "ambient-low": {
      "$description": "Diffuse separation for floating surfaces.",
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 4, "unit": "px"},
        "blur": {"value": 24, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      }
    }
  },
  "motion": {
    "$type": "transition",
    "standard": {
      "$description": "Default state transition without bounce.",
      "$value": {
        "duration": {"value": 200, "unit": "ms"},
        "delay": {"value": 0, "unit": "ms"},
        "timingFunction": [0.4, 0, 0.2, 1]
      }
    }
  },
  "breakpoints": {
    "$type": "dimension",
    "sm": {"$value": {"value": 640, "unit": "px"}},
    "lg": {"$value": {"value": 1024, "unit": "px"}}
  }
}
